    "@actions/exec": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "mocha": "^11.3.0",
    "rollup": "^4.53.3",
    "sinon": "^21.0.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.4",
    "diff": "^8.0.4"
  }
