{
  "name": "setup-xvfb",
  "version": "1.0.0",
  "packageManager": "npm",
  "type": "module",
  "description": "Run a command wrapped with Xvfb on Linux runners for headless GUI tests",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "npm install",
    "build": "rollup --config rollup.config.js",
    "test": "mocha test/**/*.test.js",
    "lint": "eslint src/**/*.js test/**/*.js"
  },
  "keywords": [
    "github-actions",
    "xvfb"
